# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile.railway — Déploiement Railway (image légère, sans torch/CLIP)
#
# Architecture : Node.js 20 + Python 3 + Higgsfield CLI + ffmpeg (bundlé pip)
# Image finale : ~600MB (vs ~8GB avec torch)
#
# Tiers Spoofer disponibles :
#   Images  : Tier 1 + 2 (light + medium)
#   Vidéos  : Tier 1 + 2 + 4 (aggressive complet)
#   Tier 3 (adversarial CLIP) → non disponible, dégradation silencieuse
#
# Motion Control + Concept Builder : 100% fonctionnels
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-slim

# ── Dépendances système minimales ────────────────────────────────────────────
# ffmpeg est bundlé via imageio-ffmpeg (pip), pas besoin de l'installer ici
# mais on le garde pour fallback et compatibilité metadata_optimizer
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Higgsfield CLI ────────────────────────────────────────────────────────────
# Version épinglée : 1.1.2+ a changé "auth login" pour un flux OAuth PKCE avec
# redirection locale (127.0.0.1:PORT), incompatible avec un CLI lancé sur un
# serveur distant pendant que le navigateur de l'utilisateur est ailleurs.
# 0.1.40 utilise le flux device-code simple (https://higgsfield.ai/device?code=...)
# qui fonctionne correctement dans ce contexte serveur.
RUN npm install -g @higgsfield/cli@0.1.40

# ── Répertoire de travail ─────────────────────────────────────────────────────
WORKDIR /app

# ── Python venv + dépendances légères (sans torch/open_clip) ─────────────────
COPY requirements-cloud.txt .
RUN python3 -m venv venv && \
    venv/bin/pip install --no-cache-dir --upgrade pip && \
    venv/bin/pip install --no-cache-dir -r requirements-cloud.txt

# ── Pipeline Python ───────────────────────────────────────────────────────────
COPY pipeline/ pipeline/
COPY skills/ skills/

# ── Next.js webapp ────────────────────────────────────────────────────────────
COPY webapp/ webapp/

WORKDIR /app/webapp

# Installer les dépendances Node (sans devDeps en prod)
RUN npm ci

# Générer le client Prisma (nécessaire avant le build)
RUN npx prisma generate

# Build Next.js (produit .next/)
RUN npm run build

# ── Port & démarrage ──────────────────────────────────────────────────────────
EXPOSE 3000

# npm start lance "next start" depuis /app/webapp
CMD ["npm", "start"]
